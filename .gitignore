# Godot 4+
.godot/
android/
ios/
*.translation

# Disabled addons
**/.disabled/**
!**/.disabled/.gdignore

# Addons holt gd-plug anhand von src/plug.gd. Versioniert wird nur gd-plug selbst.
.plugged/
/src/addons/*
!/src/addons/gd-plug/
!/src/addons/.disabled/

# Ablage für fremde Dateien und Vorlagen (nur lokal)
/.reference/*
!/.reference/.gitkeep

# Export builds
.exports/

# Import log (.import-Dateien gehören ins Repo, sie tragen die UIDs)
.import.log.txt

# Godot LSP / Editor cache
.godot/

# Python-Linter-Cache
.ruff_cache/

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Session notes (auto-generated by OpenCode / AI tools)
**/session-ses*.md

# Temporary / backup files
*~
*.swp
*.swo
*.bak
*.orig

# IDE / Editor
.vscode/
.idea/
*.code-workspace
