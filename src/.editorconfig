root = true

[*]
charset = utf-8

# GDScript: gilt für Godot, den GDQuest-Formatter (CLI und Addon) und externe Editoren.
# Regeln siehe .claude/styleguide.md im Repo der Projektsammlung
[*.gd]
indent_style = tab
max_line_length = 120
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
gdscript_formatter_blank_lines_around_definitions = 2
gdscript_formatter_continuation_indent_level = 2
gdscript_formatter_format_on_save = true

# Addons von Dritten nie formatieren
[addons/**.gd]
gdscript_formatter_format_on_save = false
